# Use Next.js BFF — recommended (same origin /api)
NEXT_PUBLIC_API_URL=/api

# Or point at Express directly (local full-stack):
# NEXT_PUBLIC_API_URL=http://localhost:5005/api

NEXT_PUBLIC_APP_NAME=BrgyDesk
# Staff sign-in URL (tenant portals redirect here)
# NEXT_PUBLIC_STAFF_LOGIN_URL=https://brgydesk.com/login
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- Supabase (use a DEV project in .env.local — see DEV_SUPABASE.md) ---
SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=your-dev-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# Production project ref (from dashboard URL) — triggers a warning if used on localhost
# SUPABASE_PRODUCTION_PROJECT_REF=abcdefghijklmnop
# Set only when you intentionally use prod DB locally:
# SUPABASE_ALLOW_PRODUCTION=true

JWT_SECRET=same-as-backend
JWT_EXPIRE=7d

# Certificate QR codes. Leave unset so Iba O' Este prints
# https://ibaoeste.brgydesk.com/verify-certificate?no=...
# Set this only to force every tenant back onto one origin (path-style URLs).
# NEXT_PUBLIC_CERT_VERIFY_BASE=https://brgydesk.vercel.app

# Optional
# NEXT_PUBLIC_TENANT_ID=ibaoeste
NODE_ENV=development

# Email (pickup notifications, assistance replies, etc.) — Gmail SMTP
# SMTP_USER=ibaoeste.portal@gmail.com
# SMTP_PASS=your-16-char-app-password
# FRONTEND_URL=https://brgydesk.com
